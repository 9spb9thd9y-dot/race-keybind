--[[
    Alien Hub | Race Reroll  (standalone, Linoria)
    - Reroll once (button or keybind)
    - Optional auto-reroll until you land one of the target races
      (Human / Mink / Shark / Angel) with a hard limit on attempts
    Uses the same remote the hub's "Reroll Race" button used:
        CommF_:InvokeServer("BlackbeardReward", "Reroll", "2")
    Also: Change to Ghoul (free) and Change to Cyborg (2500). Costs are assumed to
    be fragments, and are checked against Data.Fragments when that value exists.
    Not tested in-game.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local repo = "https://raw.githubusercontent.com/violin-suzutsuki/LinoriaLib/main/"
local okLib, Library = pcall(function()
    return loadstring(game:HttpGet(repo .. "Library.lua"))()
end)
if not okLib or not Library then
    warn("[Alien Hub] Failed to load Linoria Library: " .. tostring(Library))
    return
end
local ThemeManager = loadstring(game:HttpGet(repo .. "addons/ThemeManager.lua"))()
local SaveManager = loadstring(game:HttpGet(repo .. "addons/SaveManager.lua"))()

local Unloaded = false

local function Notify(text, duration)
    pcall(function() Library:Notify(tostring(text), duration or 3) end)
end

----------------------------------------------------------------------
-- Race helpers
----------------------------------------------------------------------
local TARGETS = { "Human", "Mink", "Shark", "Angel" }
-- Internal names are my best guess ("Skypiea" appears in the hub's original
-- code; "Fishman" is assumed for Shark). Both spellings are accepted.
local RACE_ALIASES = {
    Human = { "human" },
    Mink = { "mink" },
    Shark = { "shark", "fishman" },
    Angel = { "angel", "skypiea" },
}

local function GetRace()
    local data = LocalPlayer:FindFirstChild("Data")
    local race = data and data:FindFirstChild("Race")
    return race and tostring(race.Value) or nil
end

local function RaceMatches(raceName, target)
    if not raceName then return false end
    local lower = raceName:lower()
    for _, alias in ipairs(RACE_ALIASES[target] or {}) do
        if lower:find(alias, 1, true) then return true end
    end
    return false
end

-- Returns the first selected target that matches the current race, or nil
local function CurrentTargetHit()
    local race = GetRace()
    local selected = Options.TargetRaces and Options.TargetRaces.Value or {}
    for _, target in ipairs(TARGETS) do
        if selected[target] and RaceMatches(race, target) then return target end
    end
    return nil
end

local function SelectedTargetCount()
    local n = 0
    for _, on in pairs(Options.TargetRaces.Value) do
        if on then n = n + 1 end
    end
    return n
end

-- Costs as you gave them. The currency is assumed to be fragments.
local COSTS = { Reroll = 3000, Cyborg = 2500, Ghoul = 0 }

local function GetFragments()
    local data = LocalPlayer:FindFirstChild("Data")
    local frag = data and data:FindFirstChild("Fragments")
    return frag and tonumber(frag.Value) or nil
end

-- If the balance can't be read we don't block (the game still enforces the cost).
local function CanAfford(cost)
    local have = GetFragments()
    if have == nil then return true, nil end
    return have >= cost, have
end

local function InvokeCommF(...)
    local args = { ... }
    return pcall(function()
        local remotes = ReplicatedStorage:WaitForChild("Remotes", 5)
        local commF = remotes:WaitForChild("CommF_", 5)
        return commF:InvokeServer(unpack(args))
    end)
end

local function InvokeReroll()
    return InvokeCommF("BlackbeardReward", "Reroll", "2")
end

----------------------------------------------------------------------
-- UI
----------------------------------------------------------------------
local Window = Library:CreateWindow({
    Title = "Alien Hub | Race Reroll",
    Center = true,
    AutoShow = true,
    TabPadding = 8,
    MenuFadeTime = 0.2,
})

local Tabs = {
    Main = Window:AddTab("Race Reroll"),
    ["UI Settings"] = Window:AddTab("UI Settings"),
}

local RerollBox = Tabs.Main:AddLeftGroupbox("Reroll")
local KeyBox = Tabs.Main:AddLeftGroupbox("Keybinds")
local AutoBox = Tabs.Main:AddRightGroupbox("Auto reroll until target")

local RaceLabel = RerollBox:AddLabel("Current race: ?")
local FragLabel = RerollBox:AddLabel("Fragments: ?")
RerollBox:AddLabel("Reroll 3000 | Cyborg 2500 | Ghoul free\nSwitching to Ghoul/Cyborg may replace your current race.", true)

-- Single reroll (shared by the button and the keybind)
local busy = false
local autoRunning = false

local function RerollOnce()
    if busy then return end
    local affordable, have = CanAfford(COSTS.Reroll)
    if not affordable then
        Notify(string.format("Not enough fragments: need %d, have %d", COSTS.Reroll, have), 4)
        return
    end
    busy = true
    task.spawn(function()
        local before = GetRace()
        local ok, result = InvokeReroll()
        if not ok then
            Notify("Reroll failed: " .. tostring(result), 4)
            busy = false
            return
        end
        task.wait(Options.RerollDelay.Value)
        Notify("Reroll: " .. tostring(before) .. " -> " .. tostring(GetRace()), 4)
        busy = false
    end)
end

-- Ghoul / Cyborg (same remotes as the hub's shop buttons)
local function ChangeRace(label, cost, ...)
    if busy then return end
    local affordable, have = CanAfford(cost)
    if not affordable then
        Notify(string.format("Not enough fragments for %s: need %d, have %d", label, cost, have), 4)
        return
    end
    local args = { ... }
    busy = true
    task.spawn(function()
        local before = GetRace()
        local ok, result = InvokeCommF(unpack(args))
        if not ok then
            Notify(label .. " failed: " .. tostring(result), 4)
            busy = false
            return
        end
        task.wait(1.5)
        Notify(label .. ": " .. tostring(before) .. " -> " .. tostring(GetRace()) .. " (reply: " .. tostring(result) .. ")", 5)
        busy = false
    end)
end

local function ChangeToGhoul() ChangeRace("Ghoul", COSTS.Ghoul, "Ectoplasm", "Change", 4) end
local function ChangeToCyborg() ChangeRace("Cyborg", COSTS.Cyborg, "CyborgTrainer", "Buy") end

RerollBox:AddButton({
