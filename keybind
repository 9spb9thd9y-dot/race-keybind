----------------------------------------------------------------------
-- Auto reroll loop
----------------------------------------------------------------------
local function StopAuto()
    autoRunning = false
end

local function StartAuto()
    if autoRunning then return end
    if SelectedTargetCount() == 0 then
        Notify("Select at least one target race first.", 3)
        Toggles.AutoReroll:SetValue(false)
        return
    end
    local already = CurrentTargetHit()
    if already then
        Notify("You already have " .. already .. ".", 3)
        Toggles.AutoReroll:SetValue(false)
        return
    end

    autoRunning = true
    task.spawn(function()
        local maxCount = Options.MaxRerolls.Value
        local count = 0
        while autoRunning and not Unloaded and count < maxCount do
            count = count + 1
            local affordable, have = CanAfford(COSTS.Reroll)
            if not affordable then
                Notify(string.format("Stopped: need %d fragments, have %d", COSTS.Reroll, have), 5)
                break
            end
            local before = GetRace()
            local ok, result = InvokeCommF(8, "BlackbeardReward", "Reroll", "2")
            if not ok then
                Notify("Reroll failed: " .. tostring(result), 4)
                break
            end
            task.wait(Options.RerollDelay.Value)
            Notify(string.format("Reroll %d/%d: %s -> %s", count, maxCount, tostring(before), tostring(GetRace())), 3)
            local hit = CurrentTargetHit()
            if hit then
                Notify("Got " .. hit .. "! Stopped.", 5)
                break
            end
        end
        if autoRunning and count >= maxCount and not CurrentTargetHit() then
            Notify("Reached max rerolls (" .. maxCount .. "). Stopped.", 5)
        end
        autoRunning = false
        pcall(function() Toggles.AutoReroll:SetValue(false) end)
    end)
end

Toggles.AutoReroll:OnChanged(function()
    if Toggles.AutoReroll.Value then StartAuto() else StopAuto() end
end)

----------------------------------------------------------------------
-- Key handler
----------------------------------------------------------------------
local keyConn = UIS.InputBegan:Connect(function(input)
    if Unloaded then return end
    if UIS:GetFocusedTextBox() then return end
    if not Toggles.KeybindEnabled.Value then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    local name = input.KeyCode.Name:upper()
    if name == tostring(Options.RerollKey.Value):upper() then
        RerollOnce()
    elseif name == tostring(Options.AutoKey.Value):upper() then
        Toggles.AutoReroll:SetValue(not Toggles.AutoReroll.Value)
    elseif name == tostring(Options.GhoulKey.Value):upper() then
        ChangeToGhoul()
    elseif name == tostring(Options.CyborgKey.Value):upper() then
        ChangeToCyborg()
    end
end)

----------------------------------------------------------------------
-- On-screen button panel
----------------------------------------------------------------------
local PanelGui = nil

local function DestroyPanel()
    if PanelGui then
        pcall(function() PanelGui:Destroy() end)
        PanelGui = nil
    end
end

local function BuildPanel()
    DestroyPanel()
    local parent
    pcall(function() if gethui then parent = gethui() end end)
    if not parent then pcall(function() parent = game:GetService("CoreGui") end) end
    if not parent then parent = LocalPlayer:WaitForChild("PlayerGui") end

    local gui = Instance.new("ScreenGui")
    gui.Name = "AlienHubRaceRerollPanel"
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 999
    gui.Parent = parent

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 150, 0, 170)
    frame.Position = UDim2.new(0, 20, 0.5, -85)
    frame.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true   -- drag the panel by its background
    frame.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = frame

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 26)
    title.BackgroundTransparency = 1
    title.Font = Enum.Font.GothamBold
    title.TextSize = 13
    title.TextColor3 = Color3.fromRGB(150, 255, 150)
    title.Text = "Alien Hub | Race"
    title.Parent = frame

    local function addButton(i, text, color, fn)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, -12, 0, 30)
        b.Position = UDim2.new(0, 6, 0, 28 + (i - 1) * 34)
        b.BackgroundColor3 = color
        b.BorderSizePixel = 0
        b.Font = Enum.Font.GothamBold
        b.TextSize = 13
        b.TextColor3 = Color3.new(1, 1, 1)
        b.Text = text
        b.Parent = frame
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 6)
        c.Parent = b
        b.MouseButton1Click:Connect(fn)
    end

    addButton(1, "Roll (3000)", Color3.fromRGB(45, 120, 70), RerollOnce)
    addButton(2, "Auto start / stop", Color3.fromRGB(60, 90, 160), function()
        Toggles.AutoReroll:SetValue(not Toggles.AutoReroll.Value)
    end)
    addButton(3, "Ghoul (free)", Color3.fromRGB(110, 60, 140), ChangeToGhoul)
    addButton(4, "Cyborg (2500)", Color3.fromRGB(150, 90, 40), ChangeToCyborg)

    PanelGui = gui
end

Toggles.ShowPanel:OnChanged(function()
    if Toggles.ShowPanel.Value then BuildPanel() else DestroyPanel() end
end)

