--[[
    Alien Hub | Race Reroll  (standalone, Linoria)  -- v2
    - Reroll once (button, key, or on-screen button)
    - Optional auto-reroll until you land a target race (Human / Mink / Shark / Angel)
    - Change to Ghoul (free) / Change to Cyborg (2500)
    Fixes vs v1:
      * Keys are chosen from dropdowns (no need to press a real key to bind),
        and there is an optional on-screen button panel for touch / no keyboard.
      * A reroll no longer locks the script if the server never replies.
      * Every message is also printed to the console, so failures are visible
        even if Linoria's notification popup doesn't show.
      * "Check fragment balance" can be switched off if the balance read is wrong.
    Costs are assumed to be fragments. Not tested in-game.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local repo = "https://raw.githubusercontent.com/violin-suzutsuki/LinoriaLib/main/"
local okLib, Library = pcall(function()
    return loadstring(game:HttpGet(repo .. "Library.lua"))()
end)
if not okLib or not Library then
    warn("[Alien Hub] Failed to load Linoria Library: " .. tostring(Library))
    return
end
local ThemeManager = loadstring(game:HttpGet(repo .. "addons/ThemeManager.lua"))()
local SaveManager = loadstring(game:HttpGet(repo .. "addons/SaveManager.lua"))()

local Unloaded = false

-- Always prints; also tries the Linoria popup (not in the supplied example, so guarded)
local function Notify(text, duration)
    print("[Alien Hub] " .. tostring(text))
    pcall(function() Library:Notify(tostring(text), duration or 3) end)
end

----------------------------------------------------------------------
-- Race helpers
----------------------------------------------------------------------
local TARGETS = { "Human", "Mink", "Shark", "Angel" }
-- Internal names are my best guess ("Skypiea" appears in the hub's original
-- code; "Fishman" is assumed for Shark). Both spellings are accepted.
local RACE_ALIASES = {
    Human = { "human" },
    Mink = { "mink" },
    Shark = { "shark", "fishman" },
    Angel = { "angel", "skypiea" },
}

local function GetRace()
    local data = LocalPlayer:FindFirstChild("Data")
    local race = data and data:FindFirstChild("Race")
    return race and tostring(race.Value) or nil
end

local function RaceMatches(raceName, target)
    if not raceName then return false end
    local lower = raceName:lower()
    for _, alias in ipairs(RACE_ALIASES[target] or {}) do
        if lower:find(alias, 1, true) then return true end
    end
    return false
end

local function CurrentTargetHit()
    local race = GetRace()
    local selected = Options.TargetRaces and Options.TargetRaces.Value or {}
    for _, target in ipairs(TARGETS) do
        if selected[target] and RaceMatches(race, target) then return target end
    end
    return nil
end

local function SelectedTargetCount()
    local n = 0
    for _, on in pairs(Options.TargetRaces.Value) do
        if on then n = n + 1 end
    end
    return n
end

-- Costs as you gave them. The currency is assumed to be fragments.
local COSTS = { Reroll = 3000, Cyborg = 2500, Ghoul = 0 }

local function GetFragments()
    local data = LocalPlayer:FindFirstChild("Data")
    local frag = data and data:FindFirstChild("Fragments")
    return frag and tonumber(frag.Value) or nil
end

-- Returns true if allowed. Skipped when the check toggle is off or the balance can't be read.
local function CanAfford(cost)
    local chk = Toggles.CheckFragments
    if chk and not chk.Value then return true, nil end
    local have = GetFragments()
    if have == nil then return true, nil end
    return have >= cost, have
end

-- Sends the remote and waits for the reply, but never longer than `timeout` seconds
-- (the original lock-up: InvokeServer can yield forever if the server never answers).
local function InvokeCommF(timeout, ...)
    local args = { ... }
    local done, ok, result = false, false, nil
    task.spawn(function()
        ok, result = pcall(function()
            local remotes = ReplicatedStorage:WaitForChild("Remotes", 5)
            local commF = remotes:WaitForChild("CommF_", 5)
            return commF:InvokeServer(unpack(args))
        end)
        done = true
    end)
    local deadline = tick() + (timeout or 8)
    while not done and tick() < deadline do task.wait(0.1) end
    if not done then return true, "(no reply yet - request was sent)" end
    return ok, result
end

